# ==============================================================================
# ORION Environment Configuration
# ==============================================================================
# Tagline: "Research deeper. Verify every answer."
# Notice: Copy this file to .env and adjust variables for your local or production environment.
# Never commit real secrets to source control.

# --- Application Environment ---
ORION_ENV=development
ORION_SECRET_KEY=replace-with-a-secure-random-64-character-hex-key
DEBUG=false
LOG_LEVEL=INFO

# --- Server & CORS Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database & pgvector ---
# For Supabase PostgreSQL or local PostgreSQL with pgvector extension:
# postgresql+asyncpg://postgres:password@localhost:5432/orion
# For offline local tests / zero-dependency development, SQLite with vector emulation fallback is supported.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orion
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/orion

# --- Authentication (Supabase Auth) ---
# Supabase project URL and keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Set to true ONLY during isolated offline unit/dev testing when Supabase is not reachable.
# In production (ORION_ENV=production), this flag is strictly ignored and rejected.
DEV_AUTH_BYPASS=false

# --- Storage ---
# Storage provider: 'local' for local filesystem development, or 'supabase' for Supabase Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
SUPABASE_STORAGE_BUCKET=research-documents
MAX_UPLOAD_SIZE_MB=32
MAX_PDF_PAGES=200

# --- LLM: Google Gemini API ---
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# Recommended production model: gemini-1.5-pro, gemini-1.5-flash, or gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- Embeddings & Ingestion ---
# Default local embedding model: BAAI/bge-small-en-v1.5 (dimensions: 384)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# --- Chunking Parameters ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Retrieval Configuration ---
RETRIEVAL_TOP_K=8
HYBRID_FUSION_ALPHA=0.6
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-small

# --- Observability (Optional) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
