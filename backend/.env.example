# ==============================================================================
# ORION Backend Environment Configuration Example
# ==============================================================================
# Copy to backend/.env and provide genuine secrets. Never commit actual secrets.

# --- Application Mode & Security ---
ENVIRONMENT=development
# SECRET_KEY must be a cryptographically secure random string (min 32 characters in production)
SECRET_KEY=replace-with-a-secure-random-64-character-hex-key
# Alias for backwards compatibility:
# ORION_SECRET_KEY=replace-with-a-secure-random-64-character-hex-key
DEBUG=false
LOG_LEVEL=INFO

# --- Server & Networking ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database & pgvector ---
# For PostgreSQL with pgvector (e.g. Aiven Cloud PostgreSQL 18.6 with SSL):
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/defaultdb?ssl=require
# For offline/local test SQLite:
DATABASE_URL=sqlite+aiosqlite:///./storage/orion_dev.db

# --- Authentication & Session Security ---
DEV_AUTH_BYPASS=false
SESSION_COOKIE_NAME=orion_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRE_MINUTES=10080
CSRF_COOKIE_NAME=orion_csrf

# --- Rate Limiting ---
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

# --- Storage Provider ---
# Options: 'local' (filesystem) or 's3' (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads

# S3 / Cloudflare R2 Settings (required when STORAGE_PROVIDER=s3)
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=orion-research-documents
S3_REGION_NAME=auto
USER_STORAGE_QUOTA_MB=500

# --- Ingestion & Document Caps ---
MAX_UPLOAD_SIZE_MB=32
MAX_PDF_PAGES=200
MAX_BATCH_FILES=10
MAX_BATCH_SIZE_MB=128
USER_DOCUMENT_LIMIT=50
INGESTION_WORKER_POLL_INTERVAL_SECONDS=2.0
INGESTION_MAX_RETRIES=3

# --- LLM: Google Gemini API ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_REQUESTS_PER_MINUTE=15

# --- Local Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# --- Chunking & Retrieval Parameters ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8
HYBRID_FUSION_ALPHA=0.6
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-small
HNSW_EF_SEARCH=40

# --- Public Demo Mode Guardrails ---
ORION_ENABLE_PUBLIC_DEMO=true
DEMO_DAILY_GEMINI_BUDGET=200
DEMO_IP_RATE_LIMIT_PER_MINUTE=5
DEMO_VISITOR_DAILY_QUERY_LIMIT=20
DEMO_MAX_QUERY_LENGTH=250

# --- Admin & Permissions ---
ADMIN_EMAILS=orionadmin@gmail.com,admin@orion-assistant.ai,admin@orion.ai
ADMIN_USER_IDS=user_admin_001

