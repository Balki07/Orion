# ==============================================================================
# ORION — Git Ignore Specification
# ==============================================================================

# --- Environment & Secret Configuration Files ---
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# --- Python Virtual Environments & Packages ---
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Node & Frontend Build Artifacts ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
build/
.vite/
*.local

# --- Testing, Coverage & Caches ---
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Databases, Storage & Backups ---
*.sqlite
*.sqlite3
*.db
*.db-*
*.bak
*.bak_*
*.dump
*.sql
*.sql.gz
storage/
**/storage/
backend/storage/
scratch/

# --- IDE, Editor & OS Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
Desktop.ini
.agents/
.antigravity/

# --- Logs & Temporary Files ---
logs/
*.log
tmp/
temp/
